#!/usr/bin/env bash
# thor — monorepo command line.
#
#   tool/thor setup                 install toolchain deps (thor CLI, Playwright for the browser checks)
#   tool/thor check                 format + analyze (fatal infos) + public API + dart2js
#                                   oracle build + all tests
#   tool/thor dart2js               one app built with the dart2js oracle engine (~8 s)
#   tool/thor docs                  API reference and public API snapshot (docs/api)
#   tool/thor tutorial-check [--keep]  docs/guia/es/primera-app.md end to end: thor create outside the repo, its
#                                   files and commands, thor test/build, the built server (~30 s)
#   tool/thor docs-check [page.md]  the ```dart blocks of docs/guia/es compile (```dart no-check: partial)
#   tool/thor api                   public API against its snapshot (deprecation policy)
#   tool/thor ratchet [--update]    `thor_lints` ignores and `raw:` per package against tool/ratchet_baseline.txt
#   tool/thor test [--browser]      tests of every package and app (VM; + Chrome)
#   tool/thor build <app> [...] [--<option>...]  release build of apps (thor build;
#                                   options pass through)
#   tool/thor serve <app>           dev server, rebuilt on every change (thor dev)
#   tool/thor build-server <app>    a server app's release (thor build)
#   tool/thor export <app> [url]    server app as a static site (thor export)
#
# App commands run the thor CLI (packages/thor_cli), which also works
# outside this repository: thor create|dev|add|build|export|preview|doctor.
#   tool/thor e2e [check...] [--no-build] [--browsers[=firefox,webkit]]
#                                   browser checks (pass/fail): build, serve, run;
#                                   --browsers: the cross-browser-sensitive ones again
#                                   in Firefox and WebKit (E2E_BROWSER)
#   tool/thor visual [check|record|build] [--base <ref>] [--no-build]
#                                   screenshots of real pages vs refs (build/visual)
#   tool/thor a11y [--no-build]     axe-core on the same pages (serious/critical fail)
#   tool/thor examples-audit [...]  every live example of the docs export in headless
#                                   Chrome (tool/docs_examples_audit.mjs → build/examples_audit)
#   tool/thor hooks                 install the git pre-commit hook
#
# Every command runs from the repo root, whatever the current directory.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

PACKAGES=(packages/thor_style packages/thor_engine packages/thor_engine_oracle packages/thor_ui packages/thor_builder packages/thor_server packages/thor_studio packages/thor_test packages/thor_cli packages/thor_lints)

say() { printf '\033[1;36m▸ %s\033[0m\n' "$*"; }
fail() { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

# Where an app lives, by name: the site (apps/) or the fixtures of the
# framework checks (test/fixtures/apps/).
app_dir() {
  local root
  for root in apps test/fixtures/apps; do
    [[ -f "$root/$1/pubspec.yaml" ]] && { echo "$root/$1"; return 0; }
  done
  return 1
}

# `dart pub global run` re-resolves a path-activated package on every run and
# prints pub's "Resolving dependencies… N packages have newer versions" before
# the command's own output (even `thor --help`, ~1 s). Replace pub's script
# with a shim that runs a JIT snapshot of the CLI (~30 ms) and rebuilds it
# when a source, pubspec.lock or the Dart binary is newer. Skip with
# THOR_SETUP_SHIM=0 (pub's own script stays).
install_cli_shim() {
  [ "${THOR_SETUP_SHIM:-1}" = 0 ] && return 0
  local bin="${PUB_CACHE:-$HOME/.pub-cache}/bin"
  [ -d "$bin" ] || return 0
  say "thor shim (no pub output on each run)"
  write_cli_shim "$ROOT" "$bin/thor"
}

# The shim's body is tool/cli_shim.sh; only the checkout path goes in front,
# single-quoted (a path may hold spaces, quotes, `$`…).
write_cli_shim() {
  local root="$1" file="$2" quoted tmp
  quoted="'$(printf '%s' "$root" | sed "s/'/'\\\\''/g")'"
  tmp="$file.tmp.$$"
  { printf '#!/usr/bin/env sh\nROOT=%s\n' "$quoted"; cat "$ROOT/tool/cli_shim.sh"; } >"$tmp"
  chmod +x "$tmp"
  mv -f "$tmp" "$file"
}

cmd_setup() {
  say "Dart dependencies"
  dart pub get
  (cd packages/thor_lints && dart pub get) # analyzer plugin: own resolution
  say "thor CLI (thor create, thor dev…)"
  dart pub global activate --source path packages/thor_cli >/dev/null
  install_cli_shim
  say "Browser checks runner (Playwright)"
  (cd test/e2e/runner && npm install && npx playwright install chromium)
}

cmd_format() {
  say "Format"
  dart format --output=none --set-exit-if-changed packages apps test/fixtures tool
}

cmd_analyze() {
  say "Analyze (infos are fatal)"
  # From the workspace root, in one pass: the analyzer plugin (thor_lints)
  # only loads there; a per-package `dart analyze` skips its rules.
  #
  # `dart analyze` exits 0 when the plugin crashes or never starts, so the
  # gate would pass with no thor_lints rule run. Two guards: (1) the output
  # must not mention a plugin error; (2) a canary file that must trigger
  # `avoid_raw_css` rides in the same run (no second analyze) and is
  # filtered out of the report; if its diagnostic is missing, the plugin
  # is not alive. The canary is gitignored and removed on exit.
  local canary="packages/thor_studio/test/zz_lint_canary.dart"
  local out status=0
  out="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '$canary' '$out'" EXIT
  printf "import 'package:thor_ui/thor_ui.dart';\n\nfinal canary = StyleProps(raw: {'color': 'red'});\n" >"$canary"
  dart analyze --fatal-infos >"$out" 2>&1 || status=$?
  rm -f "$canary"
  if grep -qiE 'error occurred while executing an analyzer plugin|PluginServer' "$out"; then
    cat "$out" >&2
    fail "analyze: the thor_lints analyzer plugin failed (its rules did not run)"
  fi
  if ! grep -q 'zz_lint_canary.dart.*avoid_raw_css' "$out"; then
    cat "$out" >&2
    fail "analyze: the thor_lints canary (avoid_raw_css) did not fire: the plugin is not running"
  fi
  # Report everything except the canary and the counts that included it.
  grep -v 'zz_lint_canary.dart' "$out" | grep -vE '^[0-9]+ issues? found\.$' || true
  if grep -v 'zz_lint_canary.dart' "$out" | grep -qE '^\s*(info|warning|error) - '; then
    fail "analyze"
  fi
  # Failure with no issue line besides the canary (crash, bad options)?
  if [ "$status" -ne 0 ] && [ "$(grep -cE '^\s*(info|warning|error) - ' "$out")" -le 1 ]; then
    if ! grep -qE '^[0-9]+ issues? found\.$' "$out" || grep -qE '^(Error|Unhandled)' "$out"; then
      fail "analyze (exit $status)"
    fi
  fi
  trap - EXIT
  rm -f "$out"
}

# Tests and the gates run as tasks of a bounded pool (tool/check.mjs):
# `--jobs N`, `--changed [base]`, `--serial`, `--bail`, `--verbose`.
run_check() {
  command -v node >/dev/null || fail "node is needed (tool/check.mjs)"
  THOR_PACKAGES="${PACKAGES[*]}" \
    node tool/check.mjs "$@"
}

cmd_test() { run_check test "$@"; }

cmd_docs_check() {
  say "Guide code blocks (docs/guia) against the workspace"
  dart run tool/docs_check.dart "$@" || fail "docs-check"
}

cmd_tutorial_check() {
  say "Tutorial end to end (docs/guia/es/primera-app.md)"
  dart run tool/tutorial_check.dart "$@" || fail "tutorial-check"
}

cmd_api() {
  say "Public API"
  dart run tool/gen_api_docs.dart --check || fail "public API"
}

# The CSS escape hatches never go up (tool/ratchet.dart): `--update` lowers the
# baseline once a count fell.
cmd_ratchet() {
  say "Escape hatches (ignores and raw: per package)"
  dart run tool/ratchet.dart "$@" || fail "ratchet"
}

# The dart2js oracle engine (THOR_INTERNAL_ENGINE=dart, internal: thor ships
# lite only) of the smallest app: the golden and the VM tests only see the
# lite engine, so a dart2js-only break (a 64-bit literal reached from
# thor_ui.dart) would go unnoticed.
cmd_dart2js() {
  say "dart2js oracle engine (test/fixtures/apps/counter)"
  local log
  log="$(mktemp)"
  THOR_INTERNAL_ENGINE=dart thor_cli build test/fixtures/apps/counter >"$log" 2>&1 || {
    cat "$log" >&2
    rm -f "$log"
    fail "dart2js engine build"
  }
  rm -f "$log"
}

cmd_check() { run_check check "$@"; }

# The thor CLI of this checkout.
thor_cli() { dart run thor_cli:thor "$@"; }

cmd_build() {
  [[ $# -gt 0 ]] || fail "usage: tool/thor build <app> [<app>...] [options]"
  local app dir apps=() opts=()
  for app in "$@"; do
    if [[ "$app" == --* ]]; then opts+=("$app"); else apps+=("$app"); fi
  done
  for app in "${apps[@]}"; do
    dir="$(app_dir "$app")" || fail "no such app: $app (apps/, test/fixtures/apps/)"
    say "Build $app"
    thor_cli build "$dir" ${opts[@]+"${opts[@]}"}
  done
}

cmd_build_server() {
  [[ $# -eq 1 ]] || fail "usage: tool/thor build-server <app>"
  thor_cli build "$(app_dir "$1")"
}

cmd_serve() {
  [[ $# -eq 1 ]] || fail "usage: tool/thor serve <app>"
  thor_cli dev "$(app_dir "$1")"
}

