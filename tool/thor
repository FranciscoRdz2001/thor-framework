  # Store-page layout: Drawer(permanentWidth:, permanentPadding:) (320 px modal, 200 px panel) and
  # ExpansionTile(permanentFrom:) (accordion on a phone, open block on a desktop), with and
  # without JS; a page rendered in memory (packages/thor_ui/tool/e2e_pages.dart).
  "store-gaps::store_gaps_check.mjs"
  # The remembered light/dark choice: chosen once it holds across reloads and navigation with no
  # flash (the scheme at DOMContentLoaded), the system rules with no choice, blocked storage and a
  # foreign stored value are harmless, no JS keeps the per-view switch; pages made in memory.
  "theme-persist::theme_persist_check.mjs"
  # CarouselView: arrows inside the box, no sideways page scroll at 390/320 px, arrows move a page,
  # dots follow and jump, with and without JS; autoplay pauses and respects reduced motion; a page
  # rendered in memory (packages/thor_ui/tool/e2e_pages.dart), no app.
  "carousel::carousel_check.mjs"
  # PageView (arrows snap, locked ignores the wheel, Tab into a page), AutofillGroup (Enter submits
  # without navigating, no form in a dialog, valid autocomplete tokens), with and without JS; pages
  # rendered in memory (packages/thor_ui/tool/e2e_pages.dart), no app.
  "catalog::catalog_check.mjs"
  # The snack bar over modals: toast() with a drawer, a dialog or the confirm open shows on
  # top (top layer + inside the open dialog), floods, stacking, Esc, RTL, reduced motion, no JS;
  # a page rendered in memory (packages/thor_ui/tool/e2e_pages.dart), no app.
  "toast-modal::toast_modal_check.mjs"
  # Lists in the URL, forms that refill and keep the query, a class as the argument of a
  # query, with and without JS, on test/fixtures/apps/server_query's /orders and /edit.
  "query-forms:server_query:query_forms_check.mjs"
  # The animations page on the default (lite) engine under a burst of clicks.
  "animations-burst:lab:animations_burst_check.mjs"
  # ScrollController.animateTo/jumpTo/initialScrollOffset (RTL, reduced motion,
  # interruptions, two views) and TextEditingController.selection: pages
  # made in memory around the real runtime and controller parts.
  "controllers::controllers_check.mjs"
  # A cookie-persisted field (test/fixtures/apps/lab's /controls, «compacto») is written once per frame,
  # not per change, and the last value survives a reload right after a burst
  # (flushed on pagehide), on both engines.
  "persist:lab:persist_check.mjs"
  "persist-dart:lab:persist_check.mjs:dart"
  # PageNavigator.pop/canPop/reload: new tab, reload, hash entries, no
  # Navigation API, fallback (both engines).
  "nav-pop:lab:nav_pop_check.mjs"
  "nav-pop-dart:lab:nav_pop_check.mjs:dart"
  # The same in Chromium, WebKit and Firefox pushed further: a view that can't
  # scroll, is hidden, removed or replaced; 100 calls in a row; no `scrollend`;
  # NaN; emoji, textareas, two fields on one controller.
  "controllers-break::controllers_break_check.mjs"
  # The controllers pushed further (lite, pages in memory): identical values, IME, FocusNode listeners
  # (order, doubles, removal during a dispatch, dispose), hideToast/clearToasts, fractional and
  # unsnapped pages, nested PageViews, arrow keys, resizes, hidden views and the curves.
  "controllers-edge::controllers_edge_check.mjs"
  # Finite states that switch between structures binding other members (a
  # template with another `data-tt` in the same place).
  "lite-states::lite_states_break_check.mjs"
  # The lite engine (the default) against dart2js: the apps'
  # dart2js builds, their lite copies (tool/thor_lite.mjs), then the same
  # scenarios on both with DOM snapshots compared after every step.
  "lite:counter+list_engine+lab+content_engine+gallery_engine+realworld+grid+intl_store:lite_conformance.mjs:lite"
  # The hostile-input battery: hostile text, URLs
  # and HTML rendered by the server (nothing runs, a code URL is inert, the sanitizer cleans), and the
  # lite runtime against broken and hostile #thor-state (__proto__ at any depth, wrong types, 10 MB),
  # forged data-t-on ids, hostile row keys and oversized arguments and lists; pages made in memory
  # (packages/thor_ui/tool/security_pages.dart), no app.
  "security::security_check.mjs"
  # The runtime half of that battery on the dart2js engine: hostile #thor-state (wrong types,
  # __proto__ at any depth, 10 MB), forged data-t-on ids and hostile row data against real builds
  # of test/fixtures/apps/counter and test/fixtures/apps/lab (/rows).
  "security-dart:counter+lab:security_dart_check.mjs:dart"
  # Parity of the two engines: gestures, autocomplete and confirm()/toast() from a state on
  # the dart2js and the lite build of the same page, the DOM compared after every step (the
  # counter, lists, forms, controllers and dialogs are the `lite` conformance above).
  "parity:lab:parity_check.mjs:lite"
  # The same app checks on the dart2js oracle engine, so the lite engine
  # keeps matching it.
  "engine-redeploy-dart:counter:engine_redeploy_check.mjs:dart"
  "navigation-dart:realworld:navigation_check.mjs:dart"
  "grid-dart:grid:grid_check.mjs:dart"
  "cells-dart:cells:cells_check.mjs:export,dart"
  "dates-dart:lab:dates_check.mjs:dart"
  "dropdown-dart:lab:dropdown_check.mjs:dart"
  "autocomplete-dart:lab:autocomplete_check.mjs:dart"
  "focus-swap-dart:lab:focus_swap_check.mjs:dart"
  "focus-edge-dart:lab:focus_edge_check.mjs:dart"
  "animations-dart:lab:animations_check.mjs:dart"
  "animated-list-dart:lab:animated_list_check.mjs:dart"
  "gestures-dart:lab:gestures_check.mjs:dart"
  "early-keys-dart:lab:early_keys_check.mjs:dart"
  "early-keys-break-dart:lab:early_keys_break_check.mjs:dart"
  # Need the Flutter SDK (test/fixtures/apps/hybrid embeds a Flutter build): skipped
  # with a note where there is none, like CI.
  "hybrid:hybrid:hybrid_check.mjs:flutter"
  "hybrid-dart:hybrid:hybrid_check.mjs:flutter,dart"
)

# The checks whose result depends on the browser (focus and Tab, popovers and top
# layer, CSS animation and transition, dialogs, scroll snapping): `--browsers` runs
# them again in Firefox and WebKit through E2E_BROWSER. All render their pages in
# memory (no app to build; engine-preload serves test/fixtures/apps/counter). The ones that launch their own browsers (engine-preload,
# controllers-break, lite-list, lite-rows-break, lite-lifecycle*) take E2E_BROWSER
# too (lib/e2e.mjs browsersFor): without it each runs its own set (the plain run),
# with it only that browser. The Chromium-only ones (parity: touch by CDP) are not here.
CROSS_BROWSER_CHECKS=(
  drawer carousel catalog adaptive-layout expanded theme-persist toast-modal
  material-buttons menu-chips forms forms-upload security lite-adversarial lite-shadow lite-row-bound lite-local-storage
  lite-nested-bindings lite-widgets lite-widgets-adversarial lite-late-bindings lite-late-bindings-adversarial controllers lite-states
  engine-preload controllers-break lite-list lite-rows-break lite-lifecycle lite-lifecycle-adversarial
  dismissible dismissible-dart draggable draggable-dart lite-drag reorderable reorderable-dart lite-reorder
)

# Whether the Flutter SDK is available (FLUTTER_ROOT or flutter on PATH).
has_flutter() {
  [[ -n "${FLUTTER_ROOT:-}" && -x "$FLUTTER_ROOT/bin/flutter" ]] || command -v flutter >/dev/null
}

cmd_e2e() {
  [[ -d test/e2e/runner/node_modules/playwright ]] ||
    fail "Playwright missing: (cd test/e2e/runner && npm ci && npx playwright install chromium)"
  local names=() opts=() arg entry browsers=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-build | --bail | --verbose | --list) opts+=("$1") ;;
      --browsers) browsers="firefox,webkit" ;;
      --browsers=*) browsers="${1#--browsers=}" ;;
      --jobs) opts+=("$1" "${2:?--jobs needs a number}"); shift ;;
      -*) fail "unknown option: $1 (tool/thor e2e [check...] [--no-build] [--browsers[=list]] [--jobs N] [--bail] [--verbose])" ;;
      *) names+=("$1") ;;
    esac
    shift
  done
  local selected=()
  if [[ -n "$browsers" ]]; then
    # Only the cross-browser ones; a name given must be one of them.
    local want
    for want in ${names[@]+"${names[@]}"}; do
      [[ " ${CROSS_BROWSER_CHECKS[*]} " == *" $want "* ]] ||
        fail "$want is not a cross-browser check (one of: ${CROSS_BROWSER_CHECKS[*]})"
    done
    for entry in "${E2E_CHECKS[@]}"; do
      want="${entry%%:*}"
      if [[ ${#names[@]} -gt 0 ]]; then
        [[ " ${names[*]} " == *" $want "* ]] && selected+=("$entry")
      else
        [[ " ${CROSS_BROWSER_CHECKS[*]} " == *" $want "* ]] && selected+=("$entry")
      fi
    done
  elif [[ ${#names[@]} -eq 0 ]]; then
    selected=("${E2E_CHECKS[@]}")
  else
    local name found
    for name in "${names[@]}"; do
      found=
      for entry in "${E2E_CHECKS[@]}"; do
        [[ "${entry%%:*}" == "$name" ]] && { selected+=("$entry"); found=1; }
      done
      [[ -n "$found" ]] || fail "unknown check: $name (one of: $(printf '%s ' "${E2E_CHECKS[@]%%:*}"))"
    done
  fi
  # The Flutter ones are skipped where there is no SDK, like CI.
  local runnable=()
  for entry in "${selected[@]}"; do
    IFS=: read -r name _ _ needs <<<"$entry"
    if [[ ",$needs," == *,flutter,* ]] && ! has_flutter; then
      say "Skip $name (no Flutter SDK: set FLUTTER_ROOT or put flutter on PATH)"
      continue
    fi
    runnable+=("$entry")
  done
  if [[ -n "$browsers" ]]; then
    local b failed=()
    for b in ${browsers//,/ }; do
      say "E2E in $b (${#runnable[@]} cross-browser checks, in parallel; --jobs N)"
      E2E_BROWSER="$b" node tool/e2e.mjs --no-harness ${opts[@]+"${opts[@]}"} -- "${runnable[@]}" || failed+=("$b")
    done
    [[ ${#failed[@]} -eq 0 ]] || fail "E2E failed in: ${failed[*]}"
    return
  fi
  say "E2E (each app built once per engine, checks in parallel; --jobs N)"
  node tool/e2e.mjs ${opts[@]+"${opts[@]}"} -- "${runnable[@]}" || fail "E2E failed"
}

# The pages of the visual and a11y checks (test/e2e/checks/visual_check.mjs).
VISUAL_APPS=(landing grid realworld recipes)

visual_build() {
  local one
  for one in "${VISUAL_APPS[@]}"; do
    say "Build $one"
    thor_cli build "$(app_dir "$one")" >/dev/null || fail "build $one"
  done
  say "Export docs"
  thor_cli export apps/docs >/dev/null || fail "export docs"
}

need_playwright() {
  [[ -d test/e2e/runner/node_modules/playwright && -d test/e2e/runner/node_modules/pixelmatch ]] ||
    fail "browser deps missing: (cd test/e2e/runner && npm ci && npx playwright install chromium webkit)"
}

cmd_visual() {
  need_playwright
  local mode=check build=1 base="" arg
  while [[ $# -gt 0 ]]; do
    case "$1" in
      check | record | build) mode="$1" ;;
      --no-build) build=0 ;;
      --base) shift; base="${1:?--base needs a git ref}" ;;
      *) fail "usage: tool/thor visual [check|record|build] [--base <ref>] [--no-build]" ;;
    esac
    shift
  done
  if [[ -n "$base" ]]; then
    [[ "$mode" == check ]] || fail "--base goes with check"
    # The refs from <ref>'s pages, built in a throwaway checkout; the
    # screenshots use this checkout's script and browsers.
    local tmp
    tmp="$(mktemp -d)/base"
    git worktree add --detach "$tmp" "$base" >/dev/null || fail "no such ref: $base"
    trap 'git worktree remove --force "'"$tmp"'" >/dev/null 2>&1 || true' EXIT
    say "Refs from $base ($(git rev-parse --short "$base"))"
    (cd "$tmp" && dart pub get >/dev/null &&
      for one in "${VISUAL_APPS[@]}"; do dart run thor_cli:thor build "$(app_dir "$one")" >/dev/null || exit 1; done &&
      dart run thor_cli:thor export apps/docs >/dev/null) || fail "build of $base"
    VISUAL_APPS_ROOT="$tmp" node test/e2e/checks/visual_check.mjs record || fail "refs of $base"
  fi
  ((build)) && visual_build
  [[ "$mode" == build ]] && return
  say "Visual $mode"
  node test/e2e/checks/visual_check.mjs "$mode"
}

cmd_a11y() {
  need_playwright
  case "${1:-}" in
    "") visual_build ;;
    --no-build) ;;
    *) fail "usage: tool/thor a11y [--no-build]" ;;
  esac
  say "Accessibility (axe-core)"
  node test/e2e/checks/visual_check.mjs a11y
}

cmd_export() {
  [[ $# -ge 1 ]] || fail "usage: tool/thor export <app> [base-url]"
  thor_cli export "$(app_dir "$1")" ${2:+--base-url "$2"}
  # The docs site's search page reads a Pagefind index next to the pages:
  # without it /buscar finds nothing (DOCS_INDEX=0 skips it).
  if [[ "$1" == docs && "${DOCS_INDEX:-1}" != 0 ]]; then
    say "Search index (Pagefind)"
    tool/docs_index.sh apps/docs/build/site || fail "docs search index"
  fi
}

cmd_docs() {
  say "API reference and public API → docs/api"
  dart run tool/gen_api_docs.dart
}

cmd_hooks() {
  local hook=.git/hooks/pre-commit
  cat >"$hook" <<'HOOK'
#!/usr/bin/env bash
# Installed by tool/thor hooks: fast checks before every commit.
set -e
tool/thor format-check
tool/thor analyze
HOOK
  chmod +x "$hook"
  say "pre-commit hook installed ($hook)"
}

case "${1:-help}" in
  setup) cmd_setup ;;
  check) shift; cmd_check "$@" ;;
  format-check) cmd_format ;;
  analyze) cmd_analyze ;;
  test) shift; cmd_test "$@" ;;
  build) shift; cmd_build "$@" ;;
  serve) shift; cmd_serve "$@" ;;
  build-server) shift; cmd_build_server "$@" ;;
  export) shift; cmd_export "$@" ;;
  e2e) shift; cmd_e2e "$@" ;;
  visual) shift; cmd_visual "$@" ;;
  a11y) shift; cmd_a11y "$@" ;;
  examples-audit) shift; node tool/docs_examples_audit.mjs "$@" ;;
  docs) cmd_docs ;;
  tutorial-check) shift; cmd_tutorial_check "$@" ;;
  docs-check) shift; cmd_docs_check "$@" ;;
  api) cmd_api ;;
  ratchet) shift; cmd_ratchet "$@" ;;
  dart2js) cmd_dart2js ;;
  hooks) cmd_hooks ;;
  shim) shift; write_cli_shim "${1:?root}" "${2:?file}" ;;
  help | -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
  *) fail "unknown command: $1 (tool/thor help)" ;;
esac
